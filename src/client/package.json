{
  "name": "raft-web-client",
  "version": "1.0.0",
  "description": "Web client for Raft distributed key-value store",
  "main": "index.html",
  "scripts": {
    "build": "tsc && npx copyfiles -u 1 src/styles.css dist",
    "watch": "tsc --watch",
    "start": "npm run build && npx http-server . -p 8080 -o",
    "dev": "npm run build && npx http-server . -p 8080"
  },
  "keywords": [
    "raft",
    "web",
    "client"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "http-server": "^14.1.1",
    "typescript": "^5.3.3"
  }
}
