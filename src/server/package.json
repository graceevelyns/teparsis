{
  "name": "raft-consensus-node",
  "version": "1.0.0",
  "description": "Distributed Key-Value Store using Raft Consensus Algorithm",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "cluster": "node scripts/run-cluster.js",
